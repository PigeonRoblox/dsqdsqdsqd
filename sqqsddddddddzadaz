async function loadProfilesDB(){
  try{
    const {db,doc,getDoc}=await getDB();
    const manifestSnap=await getDoc(doc(db,'securedb','profiles_manifest')).catch(()=>null);
    const numChunks=manifestSnap&&manifestSnap.exists()?manifestSnap.data().chunks||1:1;
    const promises=[];
    for(let i=0;i<numChunks;i++) promises.push(getDoc(doc(db,'securedb','profiles_'+i)).catch(()=>null));
    promises.push(getDoc(doc(db,'securedb','profiles')).catch(()=>null));
    const snaps=await Promise.all(promises);
    const seen=new Set(); const result=[];
    snaps.forEach(s=>{if(!s||!s.exists())return;(s.data().list||[]).forEach(p=>{const k=String(p.id);if(!seen.has(k)){seen.add(k);result.push(p);}});});
    return result;
  }catch(e){console.error('loadProfilesDB',e);return [];}
}

async function saveProfilesDB(arr){
  try{
    const {db,doc,setDoc}=await getDB();
    const n=Math.ceil(arr.length/CHUNK_SIZE)||1;
    const ps=[];
    for(let i=0;i<n;i++) ps.push(setDoc(doc(db,'securedb','profiles_'+i),{list:arr.slice(i*CHUNK_SIZE,(i+1)*CHUNK_SIZE)}));
    ps.push(setDoc(doc(db,'securedb','profiles_manifest'),{chunks:n,total:arr.length,updatedAt:new Date().toISOString()}));
    await Promise.all(ps);
  }catch(e){console.error('saveProfilesDB',e);}
}

