    // Check if user can see content
    const canRead=p.fileAccess==='free'||isPremium()||(p.fileAccess==='premium'&&isPremium())||(p.fileAccess==='points'&&(_userData.points||0)>=(p.pointsCost||0));
    el.innerHTML=`${actionBtns}
