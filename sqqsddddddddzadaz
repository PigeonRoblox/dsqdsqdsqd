function buildCategories(profiles){
  const freq={};
  profiles.forEach(p=>{
    const seen=new Set();
    extractKeywords(p).forEach(w=>{if(!STOP_WORDS.has(w)&&!seen.has(w)){seen.add(w);freq[w]=(freq[w]||0)+1;}});
  });
  return Object.entries(freq).filter(([,c])=>c>=CAT_MIN).sort((a,b)=>b[1]-a[1]).slice(0,20).map(([w,c])=>({word:w,count:c}));
}

function renderCategories(profiles){
  const cats=buildCategories(profiles);
  const wrap=document.getElementById('categories-wrap');
  const btns=document.getElementById('cat-btns');
  if(!cats.length){wrap.style.display='none';return;}
  wrap.style.display='flex';btns.innerHTML='';
  const allBtn=document.createElement('button');
  allBtn.className='cat-btn'+(activeCategory===''?' active':'');
  allBtn.textContent='✦ All';
  allBtn.onclick=()=>{activeCategory='';renderCategories(profiles);renderProfiles(document.getElementById('app-search').value||'');};
  btns.appendChild(allBtn);
  cats.forEach(({word,count})=>{
    const btn=document.createElement('button');
    btn.className='cat-btn'+(activeCategory===word?' active':'');
    btn.textContent=word.toUpperCase()+' ('+count+')';
    btn.onclick=()=>{activeCategory=activeCategory===word?'':word;renderCategories(profiles);renderProfiles(document.getElementById('app-search').value||'');};
    btns.appendChild(btn);
  });
}

