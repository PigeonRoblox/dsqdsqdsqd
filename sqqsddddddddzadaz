  if(activeCategory) list=list.filter(p=>extractKeywords(p).includes(activeCategory));
  if(q){
    list=list.filter(p=>{
      const parts=[p.name||'',p.city||'',p.country||'',p.bio||'',p.mbti||'',p.languages||'',p.music||'',p.game||'',p.gender||'',p.title||'',p.fileName||'',(p.fileContent||'').slice(0,1000),...(p.hobbies||[])];
