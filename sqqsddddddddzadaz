function showAnnouncement(text,expiresAt){
  const existing=document.getElementById('announcement-bar');if(existing) existing.remove();
  if(new Date(expiresAt)<new Date()) return;
  const bar=document.createElement('div');bar.id='announcement-bar';
  bar.style.cssText='background:linear-gradient(90deg,#1a1200,#2a1f00);border-bottom:1px solid #4a3800;padding:11px 24px;display:flex;align-items:center;justify-content:center;gap:12px;position:relative;z-index:60;animation:slideDown .4s ease';
