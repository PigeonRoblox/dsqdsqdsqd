<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Secure DB</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#0c0c0c;--bg2:#131313;--bg3:#1a1a1a;--bg4:#222;
  --border:#2a2a2a;--border2:#333;
  --text:#e8e8e8;--text2:#888;--text3:#555;
  --white:#f5f5f5;--accent:#c8c8c8;
  --gold:#f0c040;--gold2:#a07800;
  --premium-bg:linear-gradient(135deg,#1a1400,#2a1f00);
  --premium-border:#4a3800;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;overflow-x:hidden}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:#0c0c0c}::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:3px}

@keyframes slideDown{from{opacity:0;transform:translateY(-28px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(0.93)}to{opacity:1;transform:scale(1)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes pulseGold{0%,100%{box-shadow:0 0 0 0 rgba(240,192,64,.3)}50%{box-shadow:0 0 0 8px rgba(240,192,64,0)}}

.page{display:none;min-height:100vh;flex-direction:column}
.page.active{display:flex}

/* ══ LOADING SCREEN ══ */
#loading-screen{
  position:fixed;inset:0;z-index:99999;
  background:#0c0c0c;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:28px;
}
.loading-logo{font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:8px;color:var(--white)}
.loading-logo span{color:#333}
.loading-spinner{width:48px;height:48px;border:3px solid #1e1e1e;border-top-color:#555;border-radius:50%;animation:spin .8s linear infinite}
.loading-text{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--text3);letter-spacing:3px;text-transform:uppercase}
.loading-bar-wrap{width:300px;height:3px;background:#1a1a1a;border-radius:2px;overflow:hidden}
.loading-bar-fill{height:100%;background:linear-gradient(90deg,#333,#888,#333);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:2px;transition:width .3s}

/* ══ KEY GATE ══ */
#keygate{
  position:fixed;inset:0;z-index:9999;
  background:#0c0c0c;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:24px;padding:24px;
}
.key-logo{font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:6px;color:var(--white)}
.key-logo span{color:#333}
.key-box{display:flex;flex-direction:column;gap:12px;background:#131313;border:1px solid var(--border2);border-radius:14px;padding:28px;width:100%;max-width:400px}
.key-input{background:#161616;border:1px solid var(--border2);border-radius:8px;color:var(--text);padding:12px 16px;font-size:14px;font-family:'JetBrains Mono',monospace;width:100%;outline:none;transition:border-color .2s;letter-spacing:1px}
.key-input:focus{border-color:#444}
.key-btn{width:100%;padding:13px;border:none;border-radius:8px;font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;cursor:pointer;transition:.3s;background:linear-gradient(135deg,#d8d8d8,#9a9a9a);color:#111}
.key-btn:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(200,200,200,.15)}
.key-btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.key-error{font-size:12px;color:#e05555;font-family:'JetBrains Mono',monospace;text-align:center;min-height:16px}

/* ══ LANDING ══ */
#landing{background:linear-gradient(180deg,#1c1c1c 0%,#0f0f0f 50%,#080808 100%)}
.nav{background:linear-gradient(180deg,#252525 0%,#161616 100%);border-bottom:1px solid var(--border);height:68px;padding:0 40px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;flex-shrink:0;animation:slideDown .5s ease both}
.nav-logo{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:4px;color:var(--white);display:flex;align-items:center;gap:10px}
.nav-logo span{color:#3a3a3a}
.nav-links{display:flex;gap:4px;align-items:center}
.nav-link{background:none;border:none;color:var(--text3);font-size:13px;font-family:'DM Sans',sans-serif;font-weight:500;cursor:pointer;padding:7px 14px;border-radius:7px;transition:.2s}
.nav-link:hover{color:var(--text);background:rgba(255,255,255,.04)}
.nav-access-btn{background:linear-gradient(135deg,#2e2e2e,#1c1c1c);border:1px solid #3e3e3e;border-radius:8px;color:var(--accent);padding:9px 22px;font-size:14px;cursor:pointer;font-family:'DM Sans',sans-serif;font-weight:600;transition:.25s;margin-left:8px}
.nav-access-btn:hover{background:linear-gradient(135deg,#3a3a3a,#262626);border-color:#555;transform:translateY(-1px)}

.hero{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:72px 24px 52px;gap:30px;position:relative;overflow:hidden}
.hero-grid{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:64px 64px;opacity:.12;mask-image:radial-gradient(ellipse 90% 70% at 50% 40%,black,transparent)}
.hero-eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:4px;color:var(--text3);text-transform:uppercase;animation:slideDown .6s .1s ease both;opacity:0;animation-fill-mode:forwards}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(62px,10vw,118px);color:var(--white);line-height:.88;letter-spacing:3px;animation:slideDown .7s .2s ease both;opacity:0;animation-fill-mode:forwards}
.hero-title .dim{color:#3a3a3a;font-size:.65em}
.cycle-word{display:inline-block;color:#777;transition:opacity .32s,transform .32s}
.hero-tagline{font-family:'Bebas Neue',sans-serif;font-size:clamp(18px,2.8vw,30px);color:#3d3d3d;letter-spacing:3px;animation:slideDown .7s .3s ease both;opacity:0;animation-fill-mode:forwards}
.hero-sub{font-size:15px;color:var(--text2);max-width:460px;line-height:1.9;animation:slideDown .7s .4s ease both;opacity:0;animation-fill-mode:forwards}
.hero-search-wrap{animation:slideDown .7s .48s ease both;opacity:0;animation-fill-mode:forwards;width:100%;max-width:480px}
.hero-search{display:flex;background:#181818;border:1px solid var(--border2);border-radius:12px;overflow:hidden}
.hero-search input{flex:1;background:none;border:none;outline:none;color:var(--text);padding:13px 18px;font-size:14px;font-family:'DM Sans',sans-serif}
.hero-search input::placeholder{color:var(--text3)}
.hero-search button{background:linear-gradient(135deg,#2e2e2e,#1a1a1a);border:none;border-left:1px solid var(--border2);color:var(--text2);padding:0 20px;cursor:pointer;font-size:18px;transition:.2s}
.hero-search button:hover{background:#333;color:var(--text)}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;animation:slideDown .7s .56s ease both;opacity:0;animation-fill-mode:forwards}
.btn-primary{background:linear-gradient(135deg,#e0e0e0,#aaa);border:none;border-radius:10px;color:#111;padding:15px 42px;font-size:15px;font-weight:700;font-family:'DM Sans',sans-serif;cursor:pointer;transition:.25s}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 36px rgba(200,200,200,.2)}
.btn-ghost{background:none;border:1px solid var(--border2);border-radius:10px;color:var(--text2);padding:15px 28px;font-size:15px;font-family:'DM Sans',sans-serif;cursor:pointer;transition:.25s}
.btn-ghost:hover{border-color:#555;color:var(--text)}
.hero-stats{display:flex;gap:48px;animation:slideDown .7s .66s ease both;opacity:0;animation-fill-mode:forwards}
.stat{text-align:center}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:42px;color:var(--text);line-height:1}
.stat-label{font-size:10px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-top:4px}
.features-strip{display:flex;border-top:1px solid var(--border);flex-shrink:0;animation:slideDown .7s .76s ease both;opacity:0;animation-fill-mode:forwards}
.feature{flex:1;padding:26px 22px;text-align:center;border-right:1px solid var(--border)}
.feature:last-child{border-right:none}
.feature-icon{font-size:26px;margin-bottom:7px}
.feature-title{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:1.5px;color:var(--text);margin-bottom:5px}
.feature-desc{font-size:12px;color:var(--text3);line-height:1.6}
.discord-banner{padding:14px 40px;background:linear-gradient(90deg,#181818,#141414);border-top:1px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;animation:slideUp .6s .9s ease both;opacity:0;animation-fill-mode:forwards}
.discord-banner a{display:flex;align-items:center;gap:10px;color:var(--text2);text-decoration:none;font-size:13px;transition:.2s}
.discord-banner a:hover{color:var(--text)}
.discord-icon{width:20px;height:20px;fill:#5865F2;flex-shrink:0}

/* ══ APP ══ */
#app{background:var(--bg)}
.app-nav{background:linear-gradient(180deg,#1e1e1e 0%,#131313 100%);border-bottom:1px solid var(--border);height:62px;padding:0 28px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;flex-shrink:0;gap:12px}
.app-logo{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:3px;color:var(--white);white-space:nowrap}
.app-logo span{color:#333}
.tab-bar{display:flex;gap:3px;background:var(--bg3);border-radius:10px;padding:3px;overflow-x:auto}
.tab{background:none;border:none;border-radius:7px;color:var(--text3);padding:7px 14px;font-size:12px;font-family:'DM Sans',sans-serif;font-weight:600;cursor:pointer;transition:.2s;white-space:nowrap}
.tab.active{background:var(--bg4);color:var(--text);box-shadow:0 2px 8px rgba(0,0,0,.4)}
.back-btn{background:none;border:1px solid var(--border);border-radius:7px;color:var(--text3);padding:6px 14px;font-size:12px;cursor:pointer;font-family:'JetBrains Mono',monospace;transition:.2s;white-space:nowrap}
.back-btn:hover{color:var(--text);border-color:#444}
.app-content{max-width:1040px;margin:0 auto;padding:36px 20px;flex:1;width:100%}

/* ══ PREMIUM BADGE ══ */
.premium-badge{display:inline-flex;align-items:center;gap:4px;background:var(--premium-bg);border:1px solid var(--premium-border);border-radius:20px;padding:2px 10px;font-size:10px;color:var(--gold);font-family:'JetBrains Mono',monospace;letter-spacing:1px}
.premium-crown{font-size:11px}

/* ══ POINTS BADGE ══ */
.points-display{display:inline-flex;align-items:center;gap:5px;background:#1a1a00;border:1px solid #3a3a00;border-radius:20px;padding:4px 12px;font-size:12px;color:#d4b800;font-family:'JetBrains Mono',monospace;cursor:pointer;transition:.2s}
.points-display:hover{background:#222200;border-color:#555500}

/* ══ SEARCH ══ */
.search-bar{display:flex;background:#181818;border:1px solid var(--border2);border-radius:10px;overflow:hidden;max-width:380px;margin-bottom:24px}
.search-bar input{flex:1;background:none;border:none;outline:none;color:var(--text);padding:11px 16px;font-size:14px;font-family:'DM Sans',sans-serif}
.search-bar input::placeholder{color:var(--text3)}
.search-bar button{background:none;border:none;border-left:1px solid var(--border);color:var(--text3);padding:0 14px;cursor:pointer;transition:.2s}
.search-bar button:hover{color:var(--text)}

/* ══ CATEGORIES ══ */
.categories-wrap{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:22px;align-items:center}
.cat-label{font-size:10px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;font-family:'JetBrains Mono',monospace;margin-right:4px;white-space:nowrap}
.cat-btn{background:rgba(255,255,255,.04);border:1px solid var(--border2);border-radius:20px;padding:5px 13px;font-size:12px;color:var(--text3);font-family:'JetBrains Mono',monospace;cursor:pointer;transition:.2s;white-space:nowrap}
.cat-btn:hover{border-color:#555;color:var(--text);background:rgba(255,255,255,.07)}
.cat-btn.active{background:rgba(255,255,255,.1);border-color:#666;color:var(--text)}

.section-header{margin-bottom:22px}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:34px;letter-spacing:2px;color:var(--white)}
.section-sub{font-size:12px;color:var(--text3);margin-top:3px;font-family:'JetBrains Mono',monospace}

/* ══ PROFILE CARDS ══ */
.profiles-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(268px,1fr));gap:16px}
.profile-card{background:linear-gradient(150deg,#1e1e1e 0%,#161616 100%);border:1px solid var(--border);border-radius:16px;padding:22px;cursor:pointer;transition:transform .25s,border-color .25s,box-shadow .25s;animation:scaleIn .4s ease both;position:relative;overflow:hidden}
.profile-card::after{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,#2e2e2e,transparent)}
.profile-card:hover{transform:translateY(-5px);border-color:#383838;box-shadow:0 20px 48px rgba(0,0,0,.6)}
.profile-card.premium-card{border-color:var(--premium-border) !important}
.profile-card.premium-card::after{background:linear-gradient(90deg,transparent,#4a3800,transparent)}
.card-banner{height:60px;border-radius:10px;margin-bottom:14px;background:linear-gradient(135deg,#1e1e1e,#2a2a2a);position:relative;overflow:hidden;flex-shrink:0}
.card-banner img{width:100%;height:100%;object-fit:cover}
.card-top{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.avatar{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#2e2e2e,#1a1a1a);border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.avatar.initials{font-family:'Bebas Neue',sans-serif;font-size:20px;color:var(--text2)}
.card-name{font-family:'Bebas Neue',sans-serif;font-size:22px;color:var(--white);letter-spacing:.5px;line-height:1}
.card-meta{font-size:12px;color:var(--text3);font-family:'JetBrains Mono',monospace;margin-top:4px}
.card-bio{font-size:13px;color:var(--text2);line-height:1.65;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;border-left:2px solid #2a2a2a;padding-left:10px;margin-bottom:12px}
.card-chips{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:12px}
.chip{background:rgba(255,255,255,.04);border:1px solid var(--border2);border-radius:20px;padding:3px 9px;font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.card-footer{display:flex;justify-content:space-between;align-items:center;padding-top:12px;border-top:1px solid var(--border)}
.card-date{font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.card-arrow{color:var(--text3);font-size:13px;transition:.2s}
.profile-card:hover .card-arrow{color:var(--text);transform:translateX(4px)}

/* file type badges */
.file-type-badge{display:inline-flex;align-items:center;gap:4px;border-radius:20px;padding:3px 10px;font-size:10px;font-family:'JetBrains Mono',monospace;font-weight:600;letter-spacing:1px}
.badge-free{background:rgba(80,200,80,.08);border:1px solid rgba(80,200,80,.2);color:#50c850}
.badge-premium{background:var(--premium-bg);border:1px solid var(--premium-border);color:var(--gold)}
.badge-points{background:#1a1a00;border:1px solid #3a3a00;color:#d4b800}

.empty-state{grid-column:1/-1;text-align:center;padding:80px 24px;background:linear-gradient(150deg,#161616,#111);border-radius:16px;border:1px dashed var(--border2);animation:fadeIn .5s ease}
.empty-icon{font-size:52px;margin-bottom:16px;animation:float 3s ease-in-out infinite;display:block}
.empty-text{color:var(--text3);font-size:14px}

/* ══ FORMS ══ */
.form-wrap{max-width:560px;margin:0 auto}
.form-section{background:linear-gradient(150deg,#191919,#131313);border:1px solid var(--border);border-radius:14px;padding:24px;margin-bottom:14px;animation:slideUp .4s ease both}
.form-section-title{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1px;color:var(--text2);margin-bottom:18px;display:flex;align-items:center;gap:8px}
.form-row{display:flex;gap:12px}
.form-field{display:flex;flex-direction:column;gap:5px;flex:1;margin-bottom:13px}
.form-label{font-size:10px;color:var(--text3);letter-spacing:2px;text-transform:uppercase;font-family:'JetBrains Mono',monospace}
.form-input,.form-textarea,.form-select{background:#161616;border:1px solid var(--border2);border-radius:8px;color:var(--text);padding:10px 14px;font-size:14px;font-family:'DM Sans',sans-serif;width:100%;outline:none;transition:border-color .2s,box-shadow .2s}
.form-input:focus,.form-textarea:focus,.form-select:focus{border-color:#444;box-shadow:0 0 0 3px rgba(255,255,255,.04)}
.form-textarea{min-height:88px;resize:vertical;line-height:1.6}
.form-select{appearance:none;cursor:pointer}
.form-select option{background:#1a1a1a}
.form-hint{font-size:11px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.submit-btn{width:100%;padding:15px;border:none;border-radius:10px;font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;cursor:pointer;transition:.3s;margin-top:6px;background:linear-gradient(135deg,#d8d8d8,#9a9a9a);color:#111}
.submit-btn:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 12px 32px rgba(200,200,200,.2)}
.submit-btn:disabled{opacity:.4;cursor:not-allowed}
.submit-btn.success{background:linear-gradient(135deg,#2d4a2d,#193319);color:#7fe07f}

/* ══ POST TYPE SWITCHER ══ */
.post-type-selector{display:flex;gap:10px;margin-bottom:24px}
.post-type-btn{flex:1;padding:14px;border:1px solid var(--border2);border-radius:10px;background:#161616;color:var(--text2);font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1.5px;cursor:pointer;transition:.2s;text-align:center}
.post-type-btn.active{border-color:#555;color:var(--text);background:#222}
.post-type-btn:hover{border-color:#444;color:var(--text)}

/* ══ FILE DROP ══ */
.file-drop-zone{border:2px dashed var(--border2);border-radius:12px;padding:48px 24px;text-align:center;cursor:pointer;transition:.2s;background:#141414}
.file-drop-zone:hover,.file-drop-zone.drag{border-color:#555;background:#1a1a1a}
.file-drop-icon{font-size:42px;margin-bottom:12px;display:block}
.file-drop-text{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:2px;color:var(--text2);margin-bottom:6px}
.file-drop-sub{font-size:12px;color:var(--text3);font-family:'JetBrains Mono',monospace}
.file-drop-zone input{display:none}
.file-preview{background:#111;border:1px solid var(--border2);border-radius:10px;padding:16px;margin-top:14px;display:none}
.file-preview-name{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--text);margin-bottom:8px;display:flex;align-items:center;gap:8px}
.file-preview-size{font-size:11px;color:var(--text3)}
.file-preview-clear{background:none;border:none;color:var(--text3);cursor:pointer;font-size:16px;margin-left:auto;transition:.2s}
.file-preview-clear:hover{color:#e05555}

/* ══ MODAL ══ */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;animation:fadeIn .2s ease;backdrop-filter:blur(8px)}
.modal{background:linear-gradient(150deg,#1d1d1d 0%,#141414 100%);border:1px solid var(--border2);border-radius:20px;width:100%;max-width:580px;max-height:90vh;overflow-y:auto;animation:scaleIn .25s ease;position:relative}
.modal-header{padding:0 0 22px;border-radius:20px 20px 0 0;border-bottom:1px solid var(--border);position:relative;overflow:hidden}
.modal-banner{height:120px;background:linear-gradient(135deg,#1e1e1e,#2a2a2a);position:relative}
.modal-banner img{width:100%;height:100%;object-fit:cover}
.modal-banner-default{width:100%;height:100%;background:linear-gradient(135deg,#1a1a1a 0%,#252525 50%,#1a1a1a 100%)}
.modal-header-inner{padding:0 28px 0}
.modal-avatar-wrap{margin-top:-32px;margin-bottom:12px}
.modal-avatar{width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#2e2e2e,#1a1a1a);border:3px solid #141414;display:flex;align-items:center;justify-content:center;font-size:34px}
.modal-avatar.initials{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--text2)}
