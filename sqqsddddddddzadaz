/* ═══════════════════════════════
   KEY GATE
═══════════════════════════════ */
const KEYS_URL='https://raw.githubusercontent.com/PigeonRoblox/Somegdfqsdq/refs/heads/main/ssdqsqddsq';

async function checkKey(){
  const input=document.getElementById('key-input').value.trim();
  const btn=document.getElementById('key-btn');
  const err=document.getElementById('key-error');
  if(!input){err.textContent='Please enter a key.';return;}
  btn.disabled=true;btn.textContent='CHECKING...';err.textContent='';
  try{
    const r=await fetch(KEYS_URL+'?nocache='+Date.now());
    const text=await r.text();
    const validKeys=text.split('\n').map(k=>k.trim()).filter(Boolean);
    if(validKeys.includes(input)){
      document.getElementById('keygate').style.display='none';
      sessionStorage.setItem('sdb-auth','1');
    } else {
      err.textContent='Invalid key. Access denied.';
      btn.disabled=false;btn.textContent='ENTER';
    }
  }catch(e){
    err.textContent='Connection error. Try again.';
    btn.disabled=false;btn.textContent='ENTER';
  }
}
if(sessionStorage.getItem('sdb-auth')==='1'){
  document.getElementById('keygate').style.display='none';
}

