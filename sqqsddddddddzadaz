function switchPostType(type){
  ['profile','file','auto'].forEach(t=>{
    const s=document.getElementById('post-'+t+'-section');
    const b=document.getElementById('ptype-'+t);
    if(s) s.style.display=t===type?'block':'none';
    if(b) b.classList.toggle('active',t===type);
  });
}

/* ═══════════════════════════════
   FILE UPLOAD
═══════════════════════════════ */
let currentFile=null,currentFileContent='';
const ALLOWED_EXT=['.txt','.json','.html'];

function fileDragOver(e){e.preventDefault();document.getElementById('file-drop-zone').classList.add('drag');}
function fileDragLeave(e){document.getElementById('file-drop-zone').classList.remove('drag');}
function fileDrop(e){e.preventDefault();document.getElementById('file-drop-zone').classList.remove('drag');const f=e.dataTransfer.files[0];if(f)processFile(f);}
function fileSelected(input){const f=input.files[0];if(f)processFile(f);}

function processFile(file){
  const ext='.'+file.name.split('.').pop().toLowerCase();
  if(!ALLOWED_EXT.includes(ext)){showToast('Only .txt, .json and .html files are allowed.');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    currentFile=file;currentFileContent=e.target.result;
    const icons={'.txt':'📝','.json':'🗂️','.html':'🌐'};
    document.getElementById('file-preview-icon').textContent=icons[ext]||'📄';
    document.getElementById('file-preview-name-text').textContent=file.name;
    document.getElementById('file-preview-size').textContent=(file.size/1024).toFixed(1)+' KB';
    document.getElementById('file-preview').style.display='block';
  };
  reader.readAsText(file);
}

function clearFile(){
  currentFile=null;currentFileContent='';
  document.getElementById('file-input').value='';
  document.getElementById('file-preview').style.display='none';
}

async function submitFile(){
  const title=document.getElementById('f-file-title').value.trim();
  if(!title){showToast('Please enter a title.');return;}
  if(!currentFile){showToast('Please select a file.');return;}
  const btn=document.getElementById('submit-file-btn');
  btn.disabled=true;btn.textContent='...';
  const ext='.'+currentFile.name.split('.').pop().toLowerCase();
  const post={id:Date.now(),createdAt:new Date().toISOString(),type:'file',
    postedBy:currentUser?currentUser.email.split('@')[0]:'Anonyme',
    title,fileName:currentFile.name,fileExt:ext,fileContent:currentFileContent};
  allProfiles=[post,...allProfiles];shuffledProfiles=[post,...shuffledProfiles];
  await saveProfilesDB(allProfiles);
  btn.classList.add('success');btn.textContent='✓ Published!';
  showToast('File published!');
  setTimeout(()=>{
    btn.classList.remove('success');btn.disabled=false;btn.textContent='PUBLISH FILE';
    document.getElementById('f-file-title').value='';clearFile();switchTab('browse');
  },1800);
}

/* ═══════════════════════════════
   AUTO-UPLOAD
═══════════════════════════════ */
let autoFile=null,autoFileContent='';

function autoFileSelected(input){const f=input.files[0];if(f)processAutoFile(f);}
function autoFileDrop(e){e.preventDefault();document.getElementById('auto-drop-zone').classList.remove('drag');const f=e.dataTransfer.files[0];if(f)processAutoFile(f);}
function clearAutoFile(){autoFile=null;autoFileContent='';document.getElementById('auto-file-input').value='';document.getElementById('auto-file-preview').style.display='none';}

function processAutoFile(file){
  const ext='.'+file.name.split('.').pop().toLowerCase();
  if(!ALLOWED_EXT.includes(ext)){showToast('Only .txt, .json and .html files are allowed.');return;}
  const reader=new FileReader();
  reader.onload=e=>{
    autoFile=file;autoFileContent=e.target.result;
    const icons={'.txt':'📝','.json':'🗂️','.html':'🌐'};
    document.getElementById('auto-preview-icon').textContent=icons[ext]||'📄';
    document.getElementById('auto-preview-name-text').textContent=file.name;
    document.getElementById('auto-preview-size').textContent=(file.size/1024).toFixed(1)+' KB';
    document.getElementById('auto-file-preview').style.display='block';
  };
  reader.readAsText(file);
}

async function submitAutoUpload(){
  const name=document.getElementById('f-auto-name').value.trim();
  const linesPerPost=parseInt(document.getElementById('f-auto-lines').value)||2;
  if(!name){showToast('Please enter an Auto Post Name.');return;}
  if(!autoFile){showToast('Please select a file.');return;}
  if(linesPerPost<1){showToast('Lines per post must be at least 1.');return;}
  const btn=document.getElementById('submit-auto-btn');btn.disabled=true;
  const allLines=autoFileContent.split('\n');
  const chunks=[];
  for(let i=0;i<allLines.length;i+=linesPerPost){const chunk=allLines.slice(i,i+linesPerPost).join('\n').trim();if(chunk)chunks.push(chunk);}
  const progress=document.getElementById('auto-progress');
  const fill=document.getElementById('auto-progress-fill');
  const label=document.getElementById('auto-progress-label');
  progress.style.display='block';
  if(!profilesLoaded) await loadAllProfiles();
  const ext='.'+autoFile.name.split('.').pop().toLowerCase();
  for(let i=0;i<chunks.length;i++){
    const post={id:Date.now()+i,createdAt:new Date().toISOString(),type:'file',
      postedBy:currentUser?currentUser.email.split('@')[0]:'Anonyme',
      title:`${name} ${i+1}`,fileName:`${name}_${i+1}${ext}`,fileExt:ext,fileContent:chunks[i]};
    allProfiles=[post,...allProfiles];shuffledProfiles=[post,...shuffledProfiles];
    const pct=Math.round(((i+1)/chunks.length)*100);
    fill.style.width=pct+'%';label.textContent=`${i+1} / ${chunks.length} posts created`;
    await new Promise(r=>setTimeout(r,60));
  }
  await saveProfilesDB(allProfiles);
  profilesLoaded=true;
  btn.classList.add('success');btn.textContent='✓ Done!';
  showToast(`${chunks.length} posts created!`);
  setTimeout(()=>{
    btn.classList.remove('success');btn.disabled=false;btn.textContent='⚡ START AUTO-UPLOAD';
    document.getElementById('f-auto-name').value='';document.getElementById('f-auto-lines').value='';
    progress.style.display='none';fill.style.width='0%';clearAutoFile();switchTab('browse');
  },2000);
}

