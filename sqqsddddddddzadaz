function appendNextPage(grid,favs){
  if(_renderedCount>=_filteredList.length) return;
  const fragment=document.createDocumentFragment();
  const end=Math.min(_renderedCount+PAGE_SIZE,_filteredList.length);
  for(let i=_renderedCount;i<end;i++) fragment.appendChild(buildCard(_filteredList[i],favs));
  _renderedCount=end;
  grid.appendChild(fragment);
  for(let i=_renderedCount-PAGE_SIZE;i<_renderedCount;i++){if(_filteredList[i]){const cb=document.getElementById('card-reactions-'+_filteredList[i].id);if(cb) renderCardReactions(_filteredList[i].id,cb);}}
  updateSentinel(grid,favs);
}

function updateSentinel(grid,favs){
  const old=document.getElementById('scroll-sentinel');if(old) old.remove();
  if(_renderedCount>=_filteredList.length) return;
  const sentinel=document.createElement('div');sentinel.id='scroll-sentinel';
  sentinel.style.cssText='grid-column:1/-1;height:60px;display:flex;align-items:center;justify-content:center';
  sentinel.innerHTML=`<div style="width:24px;height:24px;border:2px solid #2a2a2a;border-top-color:#555;border-radius:50%;animation:spin .7s linear infinite"></div>`;
  grid.appendChild(sentinel);
  if(_scrollObserver) _scrollObserver.disconnect();
  _scrollObserver=new IntersectionObserver(entries=>{if(entries[0].isIntersecting) appendNextPage(grid,favs);},{threshold:0.1});
  _scrollObserver.observe(sentinel);
}

function renderProfiles(filter=''){
  ensureSortBar();
  if(_scrollObserver){_scrollObserver.disconnect();_scrollObserver=null;}
  const grid=document.getElementById('profiles-grid');
  const sub=document.getElementById('profile-count-label');
  if(sub) sub.textContent=`${allProfiles.length} post${allProfiles.length!==1?'s':''}`;
  const q=(filter||'').toLowerCase().trim();
  let list=shuffledProfiles;
  if(activeCategory) list=list.filter(p=>extractKeywords(p).includes(activeCategory));
  if(q) list=list.filter(p=>{const parts=[p.name||'',p.city||'',p.country||'',p.bio||'',p.mbti||'',p.languages||'',p.music||'',p.game||'',p.gender||'',p.title||'',p.fileName||'',(p.fileContent||'').slice(0,200),...(p.hobbies||[])];return parts.join(' ').toLowerCase().includes(q);});
  list=getSortedList(list);
  _filteredList=list;_renderedCount=0;
  const favs=getFavorites();
  if(!list.length){
    const msg=currentSort==='favorites'?'No saved posts yet':currentSort==='trending'?'No trending posts in the last 24h':q||activeCategory?`No results for "${esc(activeCategory||q)}"`:' No posts yet — be the first!';
