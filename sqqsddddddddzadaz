function getSessionShuffle(arr){
  const KEY='sdb-shuffle-seed';let seed=sessionStorage.getItem(KEY);
  if(!seed){seed=Math.random().toString(36).slice(2);sessionStorage.setItem(KEY,seed);}
  let s=0;for(let i=0;i<seed.length;i++) s=(s*31+seed.charCodeAt(i))>>>0;
  const rng=()=>{s=(s^(s<<13))>>>0;s=(s^(s>>17))>>>0;s=(s^(s<<5))>>>0;return s/0xFFFFFFFF;};
  const a=[...arr];for(let i=a.length-1;i>0;i--){const j=Math.floor(rng()*(i+1));[a[i],a[j]]=[a[j],a[i]];}
  return a;
}

function extractKeywords(p){
  const texts=[p.name||'',p.title||'',p.bio||'',p.game||'',p.music||'',p.city||'',p.country||'',...(p.hobbies||[])];
  const words=[];
  texts.join(' ').split(/[\s,\.\-_\/\|:;!?()\[\]"']+/).forEach(w=>{const c=w.toLowerCase().replace(/[^a-zéàèùâêîôûçäëïöü]/gi,'');if(c.length>=3&&c.length<=20) words.push(c);});
  return words;
}
const STOP_WORDS=new Set(['the','and','for','with','from','that','this','was','are','not','has','have','been','its','our','you','your','him','her','they','them','who','what','when','where','how','just','like','more','some','than','then','into','only','also','both','each','here','there','these','those','will','would','could','should','very','about','after','before','les','des','une','pour','dans','sur','avec','par','qui','est','pas','que','son','ses','ils','elles','mais','donc','car','tout','plus','bien','aussi','même','puis','moi','toi','lui','nous','vous','leur','leurs','mon','ton','van','deux','trois','tous','toute','cette','cela','oui','non','très','peu','trop','www','http','https','html','css','com','net','org','php','json','xml','txt','pdf','null','true','false']);

function buildCategories(profiles){
  const freq={};
  profiles.forEach(p=>{const seen=new Set();extractKeywords(p).forEach(w=>{if(!STOP_WORDS.has(w)&&!seen.has(w)){seen.add(w);freq[w]=(freq[w]||0)+1;}});});
  return Object.entries(freq).filter(([,c])=>c>=3).sort((a,b)=>b[1]-a[1]).slice(0,20).map(([w,c])=>({word:w,count:c}));
}

function renderCategories(profiles){
  const cats=buildCategories(profiles);const wrap=document.getElementById('categories-wrap');const btns=document.getElementById('cat-btns');
  if(!cats.length){wrap.style.display='none';return;}wrap.style.display='flex';btns.innerHTML='';
  const allBtn=document.createElement('button');allBtn.className='cat-btn'+(activeCategory===''?' active':'');allBtn.textContent='✦ All';
  allBtn.onclick=()=>{activeCategory='';renderCategories(profiles);renderProfiles(document.getElementById('app-search').value||'');};btns.appendChild(allBtn);
  cats.forEach(({word,count})=>{
    const btn=document.createElement('button');btn.className='cat-btn'+(activeCategory===word?' active':'');
    btn.textContent=word.toUpperCase()+' ('+count+')';
    btn.onclick=()=>{activeCategory=activeCategory===word?'':word;renderCategories(profiles);renderProfiles(document.getElementById('app-search').value||'');};btns.appendChild(btn);
  });
}

async function loadAllProfiles(){
  if(profilesLoaded) return;
  const grid=document.getElementById('profiles-grid');grid.innerHTML='<div class="spinner"></div>';
  try{
    const {db,doc,getDoc}=await getDB();
    loadStats().catch(()=>{});
    const manifestSnap=await getDoc(doc(db,'securedb','profiles_manifest')).catch(()=>null);
    const numChunks=manifestSnap&&manifestSnap.exists()?manifestSnap.data().chunks||1:1;
    
    // Load chunks in parallel batches of 5 to avoid overloading Firestore
    const batchSize=5;const seen=new Set();
    for(let i=0;i<numChunks;i+=batchSize){
      const batch=[];
      for(let j=i;j<Math.min(i+batchSize,numChunks);j++) batch.push(getDoc(doc(db,'securedb','profiles_'+j)).catch(()=>null));
      const snaps=await Promise.all(batch);
      snaps.forEach(s=>{if(!s||!s.exists()) return;(s.data().list||[]).forEach(p=>{const k=String(p.id);if(!seen.has(k)){seen.add(k);allProfiles.push(p);}});});
      // Update count progressively
      const sc=document.getElementById('stat-count');if(sc) sc.textContent=allProfiles.length;
    }
    // Migration old doc
    try{const old=await getDoc(doc(db,'securedb','profiles'));if(old.exists())(old.data().list||[]).forEach(p=>{const k=String(p.id);if(!seen.has(k)){seen.add(k);allProfiles.push(p);}});}catch{}
    
    shuffledProfiles=getSessionShuffle([...allProfiles]);
    profilesLoaded=true;
    renderProfiles();
  }catch(e){
    console.error(e);
    allProfiles=await loadProfilesDB();
    shuffledProfiles=getSessionShuffle(allProfiles);
    profilesLoaded=true;
    renderProfiles();
  }
}

