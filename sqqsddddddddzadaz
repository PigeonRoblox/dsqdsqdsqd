function getSortedList(list){
  const favs=getFavorites();
  switch(currentSort){
    case 'recent':
      return [...list].sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));
    case 'popular':
      return [...list].sort((a,b)=>{
        const sB=REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+b.id+'_'+r.key]||0),0);
        const sA=REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+a.id+'_'+r.key]||0),0);
        return sB-sA;
      });
    case 'views':
      return [...list].sort((a,b)=>(_cachedStats['v_'+b.id]||0)-(_cachedStats['v_'+a.id]||0));
    case 'trending':{
      const now=Date.now(),h24=86400000;
      return [...list]
        .filter(p=>now-new Date(p.createdAt).getTime()<h24)
        .sort((a,b)=>{
          const sB=REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+b.id+'_'+r.key]||0),0)+(_cachedStats['v_'+b.id]||0);
          const sA=REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+a.id+'_'+r.key]||0),0)+(_cachedStats['v_'+a.id]||0);
          return sB-sA;
        });
    }
    case 'favorites':
      return list.filter(p=>favs.includes(String(p.id)));
    default:
      return list;
  }
}

