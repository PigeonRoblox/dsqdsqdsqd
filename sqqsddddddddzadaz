    case 'views': return [...list].sort((a,b)=>(_cachedStats['v_'+b.id]||0)-(_cachedStats['v_'+a.id]||0));
    case 'trending': return [...list].filter(p=>Date.now()-new Date(p.createdAt).getTime()<86400000).sort((a,b)=>(REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+b.id+'_'+r.key]||0),0)+(_cachedStats['v_'+b.id]||0))-(REACTIONS.reduce((s,r)=>s+(_cachedStats['r_'+a.id+'_'+r.key]||0),0)+(_cachedStats['v_'+a.id]||0)));
